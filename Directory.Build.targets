<Project>
  <ItemGroup>
    <CsFiles Include="**\*.*.cs" Exclude="**\*.xaml.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="@(CsFiles)">
      <DependentUpon>$([System.Text.RegularExpressions.Regex]::Replace('%(Filename)', '\..*$', '.cs'))</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>